{
  "manifest_version": 3,
  "name": "Clip to Onyx",
  "description": "Save the page, or just your selection, to your Onyx vault as a Markdown note.",
  "version": "__VERSION__",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Clip to Onyx",
    "default_icon": { "16": "images/toolbar-16.png", "32": "images/toolbar-32.png" }
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "nativeMessaging"]
}
